{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roydawsoniv:wcag-auditor:schema:manual-evidence:v1",
  "title": "Manual Accessibility Evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "outcome",
          "severity",
          "tester",
          "environment"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ruleVersion": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "inapplicable",
              "cantTell",
              "untested",
              "executionError"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "serious",
              "moderate",
              "minor",
              "advisory"
            ]
          },
          "tester": {
            "type": "string",
            "minLength": 1
          },
          "testedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "routeOrScene": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "standards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document",
                "requirement"
              ],
              "additionalProperties": false,
              "properties": {
                "document": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement": {
                  "type": "string",
                  "minLength": 1
                },
                "level": {
                  "type": "string"
                },
                "mapping": {
                  "enum": [
                    "conformance",
                    "secondary",
                    "policy"
                  ]
                }
              }
            }
          },
          "evidence": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": [
                    "passed",
                    "failed"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "testedAt",
                "expiresAt",
                "evidence"
              ],
              "properties": {
                "testedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
