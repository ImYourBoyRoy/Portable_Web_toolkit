{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roydawsoniv:wcag-auditor:schema:native-evidence:v1",
  "title": "Native Accessibility Evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "producer",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version",
        "kind"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "surfaceCount": {
      "type": "integer",
      "minimum": 0
    },
    "metadata": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ruleId",
          "title",
          "outcome",
          "severity"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "ruleVersion": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "inapplicable",
              "cantTell",
              "untested",
              "executionError"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "serious",
              "moderate",
              "minor",
              "advisory"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "automation": {
            "enum": [
              "automatic",
              "semi-automatic",
              "manual"
            ]
          },
          "target": {
            "type": "object"
          },
          "standards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document",
                "requirement"
              ],
              "additionalProperties": false,
              "properties": {
                "document": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement": {
                  "type": "string",
                  "minLength": 1
                },
                "level": {
                  "type": "string"
                },
                "mapping": {
                  "enum": [
                    "conformance",
                    "secondary",
                    "policy"
                  ]
                }
              }
            }
          },
          "evidence": {},
          "remediation": {
            "type": "string"
          },
          "helpUrl": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
