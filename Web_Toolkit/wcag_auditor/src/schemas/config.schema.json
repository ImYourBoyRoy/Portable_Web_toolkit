{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roydawsoniv:wcag-auditor:schema:config:v1",
  "title": "Roy Dawson IV WCAG Auditor Configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "adapters"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/adapter"
      }
    },
    "gate": {
      "$ref": "#/$defs/gate"
    },
    "reporters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reporter"
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suppression"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "manual-evidence",
            "native-evidence",
            "command-evidence",
            "module",
            "svelte",
            "playwright-axe"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "webServer": {
          "type": "object",
          "required": [
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cwd": {
              "type": "string",
              "minLength": 1
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "pollIntervalMs": {
              "type": "integer",
              "minimum": 1
            },
            "requestTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "shutdownTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1
            },
            "reuseExistingServer": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "reporter": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "console",
            "json",
            "sarif",
            "junit",
            "html",
            "markdown",
            "dashboard"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failOnSeverities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/severity"
          }
        },
        "failOnOutcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "unresolvedOutcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "unresolvedEvidence": {
          "enum": [
            "error",
            "ignore"
          ]
        },
        "executionErrors": {
          "enum": [
            "error",
            "ignore"
          ]
        },
        "requireApplicableSurface": {
          "type": "boolean"
        }
      }
    },
    "suppression": {
      "type": "object",
      "required": [
        "justification",
        "owner",
        "ticket",
        "createdAt",
        "expiresAt"
      ],
      "anyOf": [
        {
          "required": [
            "fingerprint"
          ]
        },
        {
          "required": [
            "ruleId"
          ]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string"
        },
        "routeOrScene": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "failed",
              "cantTell"
            ]
          },
          "description": "Which finding outcomes this suppression may cover. Defaults to [\"failed\"]. Use [\"cantTell\"] for axe incomplete contrast on glassmorphism/frost UI after manual AA verification."
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "ticket": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "inapplicable",
        "cantTell",
        "untested",
        "executionError"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "serious",
        "moderate",
        "minor",
        "advisory"
      ]
    }
  }
}
