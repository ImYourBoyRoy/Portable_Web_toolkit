# Portable toolkit environment reference
# Preferred workflow: copy keys into the TARGET PROJECT ROOT `.env`.
# `Web_Toolkit/.env` is optional (machine-level defaults only).
# Client scaffold template: `site-starter/.env.example` (keep section model in sync).
#
# A = user API secrets · B = agent + user naming · C = recommended analytics · D = optional

# ---- A) REQUIRED API CREDENTIALS (user pastes) ----
CLOUDFLARE_API_TOKEN=
GOOGLE_PAGESPEED_API_KEY=
# PAGESPEED_API_KEY=

# ---- B) AGENT + USER (propose / confirm — not raw secrets) ----
CLOUDFLARE_ACCOUNT_ID=
CF_ACCOUNT_NAME=
CF_ZONE_NAME=
CF_WORKER_NAME=
CF_PAGES_PROJECT=
CF_PAGES_PROJECT_NAME=
CF_WORKERS_DEV_SUBDOMAIN=
PUBLIC_SITE_URL=
PUBLIC_SECURITY_CONTACT=

# ---- C) RECOMMENDED ANALYTICS (explain WHY early — PostHog + GA4) ----
PUBLIC_ANALYTICS_ENABLED=true
PUBLIC_POSTHOG_API_KEY=
PUBLIC_POSTHOG_API_HOST=https://us.i.posthog.com
PUBLIC_GA4_MEASUREMENT_ID=

# ---- D) OPTIONAL FEATURES (forms, gallery, registrar tooling) ----
RESEND_API_KEY=
RESEND_FROM=
WEB3FORMS_ACCESS_KEY=
WEB3FORMS_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
INSTAGRAM_USERNAME=
INSTAGRAM_CLONE_LIMIT=24
# Porkbun is an example registrar integration — not required
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# ---- Machine / operator defaults (toolkit .env only) ----
# SMOKE_MANIFEST=./scripts/smoke-manifest.json
PORTABLE_DEFAULT_PROJECT_ROOT=
PORTABLE_DEFAULT_PROFILE=
PORTABLE_DEFAULT_PACKAGE_MANAGER=
PORTABLE_RUNTIME_DIR=.runtime
CF_OUTPUT_DIR=
CF_CACHE_PURGE_MODE=url
CF_CACHE_PURGE_BATCH_SIZE=50
CF_HOSTS_OF_INTEREST=
CF_PAGES_CUSTOM_DOMAINS=
