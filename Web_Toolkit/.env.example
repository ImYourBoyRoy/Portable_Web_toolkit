# Portable toolkit environment reference
# Preferred workflow: copy the needed keys into the TARGET PROJECT ROOT `.env`.
# `Web_Toolkit/.env` is optional and should only be used for machine-level defaults.

# ---- Preferred project-root keys for live site/tool use ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_ACCOUNT_NAME=
CF_ZONE_NAME=
GOOGLE_PAGESPEED_API_KEY=
PUBLIC_ANALYTICS_ENABLED=true
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_POSTHOG_API_KEY=
PUBLIC_POSTHOG_API_HOST=https://us.i.posthog.com
RESEND_API_KEY=
RESEND_FROM=
WEB3FORMS_ACCESS_KEY=

# ---- Optional machine defaults if you choose to keep Web_Toolkit/.env ----
PORTABLE_DEFAULT_PROJECT_ROOT=
PORTABLE_DEFAULT_PROFILE=
PORTABLE_DEFAULT_PACKAGE_MANAGER=
PORTABLE_RUNTIME_DIR=.runtime

# Usually leave this blank and use the built-in default.
CF_OUTPUT_DIR=
CF_CACHE_PURGE_MODE=url
CF_CACHE_PURGE_BATCH_SIZE=50

# ---- Porkbun registrar API (for domain NS delegation) ----
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

