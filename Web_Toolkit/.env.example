# Portable toolkit environment reference
# Preferred workflow: copy the needed keys into the TARGET PROJECT ROOT `.env`.
# `Web_Toolkit/.env` is optional and should only be used for machine-level defaults.
# Client scaffold template: `site-starter/.env.example` (keep both in sync when adding keys).

# ---- Cloudflare (live audits / deploys) ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_ACCOUNT_NAME=
CF_ZONE_NAME=
CF_WORKER_NAME=
CF_PAGES_PROJECT=
CF_PAGES_PROJECT_NAME=
CF_WORKERS_DEV_SUBDOMAIN=

# ---- PageSpeed Insights ----
GOOGLE_PAGESPEED_API_KEY=
# PAGESPEED_API_KEY=

# ---- Site / discovery ----
PUBLIC_SITE_URL=
PUBLIC_SECURITY_CONTACT=

# ---- Analytics ----
PUBLIC_ANALYTICS_ENABLED=true
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_POSTHOG_API_KEY=
PUBLIC_POSTHOG_API_HOST=https://us.i.posthog.com

# ---- Forms / email / Turnstile ----
RESEND_API_KEY=
RESEND_FROM=
WEB3FORMS_ACCESS_KEY=
WEB3FORMS_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Instagram clone (set in TARGET PROJECT .env — not toolkit secrets) ----
INSTAGRAM_USERNAME=
INSTAGRAM_CLONE_LIMIT=24

# ---- Porkbun registrar API (domain NS delegation) ----
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# ---- Batch quality smoke / operator machine defaults ----
# SMOKE_MANIFEST=./scripts/smoke-manifest.json
PORTABLE_DEFAULT_PROJECT_ROOT=
PORTABLE_DEFAULT_PROFILE=
PORTABLE_DEFAULT_PACKAGE_MANAGER=
PORTABLE_RUNTIME_DIR=.runtime

# Usually leave blank and use the built-in default.
CF_OUTPUT_DIR=
CF_CACHE_PURGE_MODE=url
CF_CACHE_PURGE_BATCH_SIZE=50
CF_HOSTS_OF_INTEREST=
CF_PAGES_CUSTOM_DOMAINS=
