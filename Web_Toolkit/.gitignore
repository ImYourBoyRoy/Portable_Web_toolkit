# Package installs / build output
node_modules/
dist/
.astro/
coverage/

# Environment / secrets (NEVER commit)
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local
.dev.vars
*.local
secrets/

# Runtime reports / generated artifacts
.runtime/
output/
**/output/
**/dist/
.cf-agent/
doctor.txt
EXPORT-METADATA.json
*.zip

# Operator session notes (local only — not published)
MEMORY.md
RED_TEAM_REPORT.md

# Site profiles: keep only public examples under version control
site-profiles/*.json
!site-profiles/example-workers.json
!site-profiles/example-pages.json
!site-profiles/README.md

# Operator-only batch smoke manifest (copy from smoke-manifest.example.json)
scripts/smoke-manifest.json

# Per-project Cloudflare resource snapshots
cloudflare.resources.json
**/cloudflare.resources.json

# Python
__pycache__/
**/__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
Thumbs.db
