{
    "name":  "cloudflare-agent-toolkit",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "author":  "Roy Dawson IV",
    "license":  "ISC",
    "description":  "Portable Cloudflare wrangler/auth/security audit and hardening toolkit for agentic workflows.",
    "bin":  {
                "cf-agent":  "./bin/cf-agent.mjs"
            },
    "scripts":  {
                    "start":  "node ./bin/cf-agent.mjs",
                    "init":  "node ./bin/cf-agent.mjs init",
                    "doctor":  "node ./bin/cf-agent.mjs doctor",
                    "permissions:audit":  "node ./bin/cf-agent.mjs permissions audit",
                    "permissions:repair":  "node ./bin/cf-agent.mjs permissions repair",
                    "site:audit":  "node ./bin/cf-agent.mjs site audit",
                    "site:harden":  "node ./bin/cf-agent.mjs site harden",
                    "dns:audit":  "node ./bin/cf-agent.mjs dns audit",
                    "dns:fix":  "node ./bin/cf-agent.mjs dns fix",
                    "deploy:dev":  "node ./bin/cf-agent.mjs deploy dev",
                    "deploy:prod":  "node ./bin/cf-agent.mjs deploy prod",
                    "cache:purge":  "node ./bin/cf-agent.mjs cache purge",
                    "workers:verify":  "node ./bin/cf-agent.mjs workers verify",
                    "env:sync":  "node ./bin/cf-agent.mjs env sync",
                    "wrangler:install":  "node ./bin/cf-agent.mjs wrangler install",
                    "wrangler:update":  "node ./bin/cf-agent.mjs wrangler update",
                    "auth:status":  "node ./bin/cf-agent.mjs auth status",
                    "auth:login":  "node ./bin/cf-agent.mjs auth login",
                    "auth:logout":  "node ./bin/cf-agent.mjs auth logout",
                    "auth:wipe":  "node ./bin/cf-agent.mjs auth wipe",
                    "audit:token":  "node ./bin/cf-agent.mjs audit token",
                    "audit:zone":  "node ./bin/cf-agent.mjs audit zone",
                    "harden:zone":  "node ./bin/cf-agent.mjs harden zone",
                    "test:minify":  "node ./bin/cf-agent.mjs test minify",
                    "pages:list":  "node ./bin/cf-agent.mjs pages list",
                    "pages:domains":  "node ./bin/cf-agent.mjs pages domains",
                    "pages:setup":  "node ./bin/cf-agent.mjs pages setup",
                    "scaffold:analytics:astro":  "node ./bin/cf-agent.mjs scaffold astro-analytics",
                    "verify":  "node ./scripts/verify-output.mjs",
                    "export":  "node ./scripts/export-toolkit.mjs"
                }
}
