---
// ./src/components/Schema.astro
/** JSON-LD: WebSite, primary entity, WebPage, BreadcrumbList — customize site-config.ts */
import { siteConfig } from '../lib/site-config';

interface Props {
  title?: string;
  description?: string;
  schemaType?: 'WebPage' | 'Organization' | 'Person' | 'LocalBusiness';
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  schemaType = 'WebPage',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalURL = siteUrl ? new URL(Astro.url.pathname, `${siteUrl}/`).href : Astro.url.href;
const entityType = siteConfig.schemaType;

const entitySchema = {
  '@context': 'https://schema.org',
  '@type': entityType,
  '@id': siteUrl ? `${siteUrl}#entity` : undefined,
  name: siteConfig.name,
  description: siteConfig.description,
  ...(siteUrl ? { url: siteUrl } : {}),
};

const websiteSchema = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: siteConfig.name,
      url: siteUrl,
      publisher: { '@id': `${siteUrl}#entity` },
    }
  : null;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  description,
  url: canonicalURL,
  ...(siteUrl ? { isPartOf: { '@id': `${siteUrl}#website` } } : {}),
};

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbSchema = siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
        ...pathSegments.map((segment, index) => ({
          '@type': 'ListItem',
          position: index + 2,
          name: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
          item: new URL(`/${pathSegments.slice(0, index + 1).join('/')}`, `${siteUrl}/`).href,
        })),
      ],
    }
  : null;

const combinedSchema = [entitySchema, websiteSchema, pageSchema, breadcrumbSchema].filter(Boolean);
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(combinedSchema)} />
