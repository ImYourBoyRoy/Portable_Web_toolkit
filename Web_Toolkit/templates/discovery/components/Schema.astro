---
// ./src/components/Schema.astro
/**
 * JSON-LD for every page as one @graph with stable @id references: primary entity (siteConfig.schemaType),
 * WebSite, WebPage and BreadcrumbList. Only claims what site-config.ts declares. Customize site-config.ts.
 * Extend the graph per page type (ItemList, Service/Offer, SoftwareApplication, FAQPage) only with content the page shows.
 */
import { siteConfig } from '../lib/site-config';
import { canonicalPagePath, canonicalUrl } from '../lib/discovery/site';
import { getPublicPageRoutes } from '../lib/discovery/routes';

interface Props {
  title?: string;
  description?: string;
  schemaType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'ProfilePage';
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  schemaType = 'WebPage',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = siteUrl ? `${siteUrl}/` : '';
const pagePath = canonicalPagePath(Astro.url.pathname);
const pageUrl = base ? new URL(pagePath, base).href : Astro.url.href;
const ids = {
  entity: `${base}#entity`,
  website: `${base}#website`,
  page: `${pageUrl}#webpage`,
  breadcrumb: `${pageUrl}#breadcrumb`,
};

const lastmod = getPublicPageRoutes().find((route) => route.path === pagePath)?.lastmod ?? null;

const entity: Record<string, unknown> = {
  '@type': siteConfig.schemaType,
  '@id': ids.entity,
  name: siteConfig.name,
  description: siteConfig.description,
  ...(base ? { url: base } : {}),
  ...(siteConfig.legalName && siteConfig.legalName !== siteConfig.name ? { alternateName: siteConfig.legalName } : {}),
  ...(siteConfig.sameAs.length ? { sameAs: siteConfig.sameAs } : {}),
};

const website = {
  '@type': 'WebSite',
  '@id': ids.website,
  name: siteConfig.name,
  description: siteConfig.description,
  inLanguage: 'en',
  ...(base ? { url: base } : {}),
  publisher: { '@id': ids.entity },
};

const segments = pagePath.split('/').filter(Boolean);
const breadcrumb = {
  '@type': 'BreadcrumbList',
  '@id': ids.breadcrumb,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: base || '/' },
    ...segments.map((segment, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
      item: canonicalUrl(siteUrl, `/${segments.slice(0, index + 1).join('/')}/`),
    })),
  ],
};

const page = {
  '@type': schemaType,
  '@id': ids.page,
  url: pageUrl,
  name: title,
  description,
  inLanguage: 'en',
  isPartOf: { '@id': ids.website },
  about: { '@id': ids.entity },
  breadcrumb: { '@id': ids.breadcrumb },
  ...(lastmod ? { dateModified: lastmod } : {}),
};

const graph = { '@context': 'https://schema.org', '@graph': [entity, website, page, breadcrumb] };
const json = JSON.stringify(graph).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
---

<script type="application/ld+json" is:inline set:html={json} />
