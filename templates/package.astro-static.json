{
  "$schema": "./package.astro-workers.schema.json",
  "name": "[PROJECT_NAME]",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "npm run clean && astro dev",
    "build": "node scripts/prebuild.mjs && astro build && node scripts/postbuild.mjs",
    "build:clear": "npm run clean && npm run build",
    "build:headers:prod": "node ./scripts/build-headers.mjs production",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "check": "astro check",
    "clean": "rimraf .astro node_modules/.vite dist",
    "upgrade:astro": "npx @astrojs/upgrade",
    "check:wrangler": "node ./scripts/check-wrangler-versions.mjs",
    "upgrade:wrangler": "npm install -D wrangler@latest @cloudflare/workers-types@latest && node ./scripts/check-wrangler-versions.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.0.0",
    "astro": "^7.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260623.1",
    "@types/node": "^26.0.0",
    "rimraf": "^6.1.3",
    "wrangler": "^4.104.0"
  },
  "_templateNotes": {
    "useWhen": "Static marketing sites with custom pre/post build steps (maps, sitemaps, asset pipelines).",
    "astroConfig": "output: static, adapter with prerenderEnvironment: node",
    "wrangler": "Minimal wrangler.toml at project root; deploy via dist/server/wrangler.json when using adapter."
  }
}
