{
  "$schema": "./package.astro-workers.schema.json",
  "name": "[PROJECT_NAME]",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "npm run clean && astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:clear": "npm run clean && astro build",
    "build:headers:prod": "node ./scripts/build-headers.mjs production",
    "check": "astro check",
    "clean": "rimraf .astro node_modules/.vite dist",
    "clean:cache": "node ./scripts/clean-local-cache.mjs",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "cf:deploy": "npm run build && npm run build:headers:prod && wrangler deploy --config dist/server/wrangler.json",
    "cf:deploy:clean": "npm run clean && npm run cf:deploy",
    "upgrade:astro": "npx @astrojs/upgrade",
    "check:wrangler": "node ./scripts/check-wrangler-versions.mjs",
    "upgrade:wrangler": "npm install -D wrangler@latest @cloudflare/workers-types@latest && node ./scripts/check-wrangler-versions.mjs",
    "upgrade:all": "npm update && npm run upgrade:wrangler",
    "quality:smoke": "node ./Web_Toolkit/site_quality_smoke/bin/site-quality-smoke.mjs run --site-profile <SITE_PROFILE>",
    "cache:purge": "node ./Web_Toolkit/cache_purge/bin/cache-purge.mjs --site-profile <SITE_PROFILE> --apply",
    "styles:check": "node ./Web_Toolkit/stylesheet_check/bin/stylesheet-check.mjs scan --root ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.0.0",
    "astro": "^7.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260623.1",
    "@types/node": "^26.0.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "wrangler": "^4.104.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  },
  "_templateNotes": {
    "mergePerSite": [
      "Keep project-specific scripts (assets, WordPress sourcing, tests, content pipelines).",
      "Keep project-specific dependencies (react, hono, zod, font packages, etc.).",
      "Replace cf:deploy route/name flags from site profile — never copy from another site.",
      "For static prerender sites, set output: static in astro.config; adapter still required for Workers deploy.",
      "Static sites that use Node-only prerender APIs: adapter prerenderEnvironment: 'node'.",
      "Link Web_Toolkit: node <Portable_Web_toolkit>/scripts/link-web-toolkit.mjs --toolkit-path <Web_Toolkit-abs> --project-root .",
      "Optional: cross-env CLOUDFLARE_VITE_PLUGIN_SKIP_PREVIEW=true on build if preview plugin conflicts during CI."
    ]
  }
}
