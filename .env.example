# Toolkit repository / operator defaults (not a client site).
# For website projects, copy `site-starter/.env.example` → project `.env.example` / `.env`.
# A = user API · B = agent+user · C = PostHog+GA4 recommended · D = optional (see site-starter)

# ---- A) REQUIRED API CREDENTIALS ----
CLOUDFLARE_API_TOKEN=
GOOGLE_PAGESPEED_API_KEY=
# PAGESPEED_API_KEY=

# ---- B) AGENT + USER ----
CLOUDFLARE_ACCOUNT_ID=
CF_ZONE_NAME=
CF_PAGES_PROJECT=
CF_WORKER_NAME=

# ---- C) RECOMMENDED ANALYTICS (explain early) ----
# PUBLIC_POSTHOG_API_KEY=
# PUBLIC_POSTHOG_API_HOST=https://us.i.posthog.com
# PUBLIC_GA4_MEASUREMENT_ID=

# Site profile for root npm scripts (site-tool.mjs)
# Example: PORTABLE_DEFAULT_PROFILE=Web_Toolkit/site-profiles/example-workers.json
PORTABLE_DEFAULT_PROFILE=
