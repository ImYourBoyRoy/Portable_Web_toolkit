# Toolkit repository / operator defaults (not a client site).
# For website projects, copy `site-starter/.env.example` → project `.env.example` / `.env`.

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_ZONE_NAME=
CF_PAGES_PROJECT=
CF_WORKER_NAME=

# Site profile for root npm scripts (site-tool.mjs)
# Example: PORTABLE_DEFAULT_PROFILE=Web_Toolkit/site-profiles/example-workers.json
PORTABLE_DEFAULT_PROFILE=

# PageSpeed Insights
GOOGLE_PAGESPEED_API_KEY=
# PAGESPEED_API_KEY=
