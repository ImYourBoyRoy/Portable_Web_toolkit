# Infrastructure
CLOUDFLARE_API_TOKEN=your_token_here
CLOUDFLARE_ACCOUNT_ID=your_id_here
CF_PAGES_PROJECT=your_pages_project_name

# Site profile resolution for root npm scripts (site-tool.mjs)
