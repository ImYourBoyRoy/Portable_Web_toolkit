{
  "name": "[PROJECT_NAME]",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "pnpm run clean && astro dev",
    "start": "astro dev",
    "prebuild": "node ./scripts/refresh-page-lastmod.mjs",
    "build": "astro build",
    "build:clear": "pnpm run clean && astro build",
    "build:headers:prod": "node ./Web_Toolkit/headers_deploy/bin/headers-deploy.mjs write-deploy --project-root . --environment production --apply && node ./scripts/discovery-postbuild.mjs ./dist",
    "build:headers:dev": "node ./Web_Toolkit/headers_deploy/bin/headers-deploy.mjs write-deploy --project-root . --environment development --apply",
    "check": "astro check",
    "clean": "node ./Web_Toolkit/scripts/clean-local-cache.mjs",
    "clean:cache": "node ./Web_Toolkit/scripts/clean-local-cache.mjs",
    "preview": "pnpm exec wrangler pages dev dist",
    "cf:deploy": "pnpm run build && pnpm run build:headers:prod && pnpm exec wrangler pages deploy dist --project-name [PAGES_PROJECT_NAME] --branch main",
    "cf:deploy:preview": "pnpm run build && pnpm run build:headers:prod && pnpm exec wrangler pages deploy dist --project-name [PAGES_PROJECT_NAME] --branch preview",
    "cf:deploy:clean": "pnpm run clean && pnpm run cf:deploy",
    "upgrade:astro": "node ./Web_Toolkit/package_updater/bin/package-updater.mjs run --project-root .",
    "check:wrangler": "node ./Web_Toolkit/scripts/check-wrangler-versions.mjs",
    "upgrade:wrangler": "node ./Web_Toolkit/package_updater/bin/package-updater.mjs run --project-root . --apply && node ./Web_Toolkit/scripts/check-wrangler-versions.mjs",
    "upgrade:all": "node ./Web_Toolkit/package_updater/bin/package-updater.mjs run --project-root . --apply",
    "quality:smoke": "node ./Web_Toolkit/site_quality_smoke/bin/site-quality-smoke.mjs run --site-profile ./[SITE_PROFILE].json",
    "discovery:doctor": "node ./Web_Toolkit/discovery_doctor/bin/discovery-doctor.mjs ./dist",
    "discovery:check": "node ./scripts/discovery-check.mjs ./dist",
    "readiness": "node ./Web_Toolkit/site_readiness/bin/site-readiness.mjs run --project-root .",
    "readiness:fix": "node ./Web_Toolkit/site_readiness/bin/site-readiness.mjs run --project-root . --apply-safe-fixes",
    "package_updater": "node ./Web_Toolkit/package_updater/bin/package-updater.mjs run --project-root . --apply",
    "styles:check": "node ./Web_Toolkit/stylesheet_check/bin/stylesheet-check.mjs scan --root .",
    "toolchain:doctor": "node ./Web_Toolkit/package_updater/bin/package-updater.mjs doctor"
  },
  "dependencies": {
    "@astrojs/upgrade": "^0.8.1",
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.8",
    "astro": "^7.4.12",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "yaml": "^2.9.1",
    "yaml-language-server": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^26.6.6",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "yaml": "$yaml",
    "yaml-language-server": "$yaml-language-server"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
