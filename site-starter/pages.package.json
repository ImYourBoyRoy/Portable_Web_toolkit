{
  "name": "[PROJECT_NAME]",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "npm run clean && astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:clear": "npm run clean && astro build",
    "build:headers:prod": "node ./scripts/build-headers.mjs production",
    "build:headers:dev": "node ./scripts/build-headers.mjs development",
    "check": "astro check",
    "clean": "rimraf .astro node_modules/.vite dist",
    "clean:cache": "node ./scripts/clean-local-cache.mjs",
    "preview": "npx wrangler pages dev dist",
    "cf:deploy": "npm run build && npm run build:headers:prod && npx wrangler pages deploy dist --project-name [PAGES_PROJECT_NAME] --branch main",
    "cf:deploy:preview": "npm run build && npm run build:headers:prod && npx wrangler pages deploy dist --project-name [PAGES_PROJECT_NAME] --branch preview",
    "cf:deploy:clean": "npm run clean && npm run cf:deploy",
    "upgrade:astro": "npx @astrojs/upgrade",
    "check:wrangler": "node ./scripts/check-wrangler-versions.mjs",
    "upgrade:wrangler": "npm install -D wrangler@latest @cloudflare/workers-types@latest && node ./scripts/check-wrangler-versions.mjs",
    "upgrade:all": "npm update && npm run upgrade:wrangler",
    "quality:smoke": "node ./Web_Toolkit/site_quality_smoke/bin/site-quality-smoke.mjs run --site-profile ./[SITE_PROFILE].json",
    "discovery:doctor": "node ./Web_Toolkit/discovery_doctor/bin/discovery-doctor.mjs ./dist",
    "readiness": "node ./scripts/readiness.mjs",
    "readiness:fix": "node ./scripts/readiness.mjs --apply-safe-fixes",
    "styles:check": "node ./Web_Toolkit/stylesheet_check/bin/stylesheet-check.mjs scan --root ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^7.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "rimraf": "^6.1.3",
    "wrangler": "^4.104.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
