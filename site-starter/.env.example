# =============================================================================
# Client project `.env` template (copy to project-root `.env` — never commit live values)
# =============================================================================
# Division of labor:
#   A) REQUIRED API CREDENTIALS — user pastes secrets only they can create
#   B) AGENT + USER — agent proposes names/IDs from domain/folder; confirm with user
#   C) RECOMMENDED ANALYTICS — explain WHY early (PostHog + GA4); user pastes keys if agreed
#   D) OPTIONAL FEATURES — forms, gallery, registrar tooling (e.g. Porkbun as one example)
#
# Agents: be curious and challenge vague answers. Propose concrete names.
# Do not dump the whole file on the user and ask them to "fill everything out."
# =============================================================================

# -----------------------------------------------------------------------------
# A) REQUIRED API CREDENTIALS (user pastes — agent never invents these)
# -----------------------------------------------------------------------------
# Cloudflare: My Profile → API Tokens → Create Token (Custom). See ONBOARDING_STAGES S3.
CLOUDFLARE_API_TOKEN=

# Google PageSpeed Insights API key (pagespeed-diagnostics / quality smoke / launch gates).
# Create at Google Cloud Console → enable PageSpeed Insights API → API key.
GOOGLE_PAGESPEED_API_KEY=
# PAGESPEED_API_KEY=

# -----------------------------------------------------------------------------
# B) AGENT + USER (agent fills WITH the user — propose, challenge, confirm)
# -----------------------------------------------------------------------------
# After CLOUDFLARE_API_TOKEN is set, agent should look up account id via API when possible.
CLOUDFLARE_ACCOUNT_ID=
CF_ACCOUNT_NAME=

# Production zone / apex domain (from S5 interview — not a secret).
CF_ZONE_NAME=

# Deploy resource names — derive from domain/folder; challenge collisions / vague names.
# Workers sites:
CF_WORKER_NAME=
# CF_WORKERS_DEV_SUBDOMAIN=
# Pages sites:
# CF_PAGES_PROJECT=
# CF_PAGES_PROJECT_NAME=

# Public URL + security contact for discovery / security.txt (agent proposes from domain).
PUBLIC_SITE_URL=
PUBLIC_SECURITY_CONTACT=

# -----------------------------------------------------------------------------
# C) RECOMMENDED ANALYTICS (explain early in S5/S7 — not silent optional)
# -----------------------------------------------------------------------------
# PostHog: product analytics, session replay, funnels — best for understanding real
# visitor behavior and debugging UX after launch. Prefer enabling on most sites.
# PUBLIC_POSTHOG_API_KEY=
# PUBLIC_POSTHOG_API_HOST=https://us.i.posthog.com

# GA4: industry-standard traffic/acquisition reporting; useful for clients who already
# live in Google Analytics / Ads / Search Console. Pair with PostHog when possible.
# PUBLIC_GA4_MEASUREMENT_ID=

# PUBLIC_ANALYTICS_ENABLED=true

# -----------------------------------------------------------------------------
# D) OPTIONAL FEATURES (only when user opted in — otherwise leave blank)
# -----------------------------------------------------------------------------
# Forms / contact (Workers typically) + Turnstile
# WEB3FORMS_ACCESS_KEY=
# WEB3FORMS_KEY=
# RESEND_API_KEY=
# RESEND_FROM=
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Public Instagram gallery (instagram-clone / ig:clone)
# INSTAGRAM_USERNAME=
# INSTAGRAM_CLONE_LIMIT=24

# Registrar DNS/NS automation — OPTIONAL. Porkbun is one supported example, not required.
# Use whatever registrar the domain actually uses; only set keys if toolkit will manage NS.
# PORKBUN_API_KEY=
# PORKBUN_SECRET_KEY=

# Operator / CI optional
# CF_OUTPUT_DIR=
# CF_CACHE_PURGE_MODE=url
# CF_CACHE_PURGE_BATCH_SIZE=50
# CF_HOSTS_OF_INTEREST=
# SMOKE_MANIFEST=
