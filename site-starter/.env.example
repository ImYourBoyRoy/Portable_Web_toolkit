# Cloudflare operator (required for live audits / deploys — never commit live values)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CF_ACCOUNT_NAME=
# CF_ZONE_NAME=

# Deploy target hints (match site profile + wrangler names)
# CF_WORKER_NAME=
# CF_PAGES_PROJECT=
# CF_PAGES_PROJECT_NAME=
# CF_WORKERS_DEV_SUBDOMAIN=

# PageSpeed Insights (pagespeed-diagnostics / quality smoke)
GOOGLE_PAGESPEED_API_KEY=
# PAGESPEED_API_KEY=

# Public site URL / discovery overrides
# PUBLIC_SITE_URL=https://your-production-domain.example
# PUBLIC_SECURITY_CONTACT=mailto:security@your-domain.example

# Analytics (optional)
# PUBLIC_ANALYTICS_ENABLED=true
# PUBLIC_GA4_MEASUREMENT_ID=
# PUBLIC_POSTHOG_API_KEY=
# PUBLIC_POSTHOG_API_HOST=https://us.i.posthog.com

# Forms / contact (Workers sites typically; Turnstile + provider keys)
# WEB3FORMS_ACCESS_KEY=
# WEB3FORMS_KEY=
# RESEND_API_KEY=
# RESEND_FROM=
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional public Instagram gallery (instagram-clone / ig:clone)
# INSTAGRAM_USERNAME=
# INSTAGRAM_CLONE_LIMIT=24

# Registrar (Porkbun) — only when managing DNS/NS from toolkit
# PORKBUN_API_KEY=
# PORKBUN_SECRET_KEY=

# Operator / CI optional
# CF_OUTPUT_DIR=
# CF_CACHE_PURGE_MODE=url
# CF_CACHE_PURGE_BATCH_SIZE=50
# CF_HOSTS_OF_INTEREST=
# SMOKE_MANIFEST=
