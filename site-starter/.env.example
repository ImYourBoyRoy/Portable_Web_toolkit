# Cloudflare (operator — do not commit live values)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Discovery — optional override for security.txt (mailto: or https:)
# PUBLIC_SECURITY_CONTACT=mailto:security@your-domain.example

# Optional public Instagram gallery (instagram-clone / ig:clone)
# INSTAGRAM_USERNAME=
# INSTAGRAM_CLONE_LIMIT=24

# Optional site URL override
# PUBLIC_SITE_URL=https://your-production-domain.example
