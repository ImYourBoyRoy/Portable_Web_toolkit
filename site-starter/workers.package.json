{
  "name": "[PROJECT_NAME]",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "npm run clean && astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:clear": "npm run clean && astro build",
    "build:headers:prod": "node ./Web_Toolkit/headers_deploy/bin/headers-deploy.mjs write-deploy --project-root . --environment production",
    "build:headers:dev": "node ./Web_Toolkit/headers_deploy/bin/headers-deploy.mjs write-deploy --project-root . --environment development",
    "check": "astro check",
    "clean": "rimraf .astro node_modules/.vite dist",
    "clean:cache": "node ./Web_Toolkit/scripts/clean-local-cache.mjs",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "cf:deploy": "npm run build && npm run build:headers:prod && wrangler deploy --config dist/server/wrangler.json",
    "cf:deploy:clean": "npm run clean && npm run cf:deploy",
    "upgrade:astro": "npx @astrojs/upgrade",
    "check:wrangler": "node ./Web_Toolkit/scripts/check-wrangler-versions.mjs",
    "upgrade:wrangler": "npm install -D wrangler@latest @cloudflare/workers-types@latest && node ./scripts/check-wrangler-versions.mjs",
    "upgrade:all": "npm update && npm run upgrade:wrangler",
    "quality:smoke": "node ./Web_Toolkit/site_quality_smoke/bin/site-quality-smoke.mjs run --site-profile ./[SITE_PROFILE].json",
    "discovery:doctor": "node ./Web_Toolkit/discovery_doctor/bin/discovery-doctor.mjs ./dist/client",
    "readiness": "node ./Web_Toolkit/site_readiness/bin/site-readiness.mjs run --project-root .",
    "readiness:fix": "node ./Web_Toolkit/site_readiness/bin/site-readiness.mjs run --project-root . --apply-safe-fixes",
    "package_updater": "node ./Web_Toolkit/package_updater/bin/package-updater.mjs run --project-root . --apply",
    "styles:check": "node ./Web_Toolkit/stylesheet_check/bin/stylesheet-check.mjs scan --root ."
  },
  "dependencies": {
    "@astrojs/upgrade": "^0.7.3",
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.0.1",
    "astro": "^7.0.3",
	"playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260624.1",
    "@types/node": "^26.0.1",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "wrangler": "^4.105.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
