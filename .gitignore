# build output / generated reports
example-pages-site/
**/output/site-quality-smoke-*
**/output/site-readiness-*
output/
.wrangler/
.runtime/
.cf-agent/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/*
!tmp/.gitkeep

# environment variables / secrets (NEVER commit — tokens stay local only)
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local
.envrc
.dev.vars
*.local
secrets/
**/secrets/

# operator-local GitHub metadata overrides (public copy: docs/github-repository.json)
github-repository.local.json
**/github-repository.local.json

# operator session memory (local only — copy from MEMORY.example.md)
MEMORY.md
**/MEMORY.md
!MEMORY.example.md
!**/MEMORY.example.md

# operator red-team notes (local only — copy from RED_TEAM_REPORT.example.md)
RED_TEAM_REPORT.md
**/RED_TEAM_REPORT.md
!RED_TEAM_REPORT.example.md
!**/RED_TEAM_REPORT.example.md

# private site profiles stay outside published toolkit copies
Private_Site_Profiles/

# operator-only batch smoke manifests (use smoke-manifest.example.json in repo)
**/smoke-manifest.json
!**/smoke-manifest.example.json

# per-project / operator Cloudflare resource snapshots
**/cloudflare.resources.json
**/cf-agent/

# generated export artifacts
EXPORT-METADATA.json
*.zip
doctor.txt

# macOS-specific files
.DS_Store
Thumbs.db
desktop.ini

# test / coverage artifacts
coverage/

# key material (never commit)
*.pem
*.key
!**/*.example.key

# jetbrains setting folder
.idea/

# python
__pycache__/
**/__pycache__/
*.pyc
.venv/
